# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
NODE_ENV="development"
PORT="3000"
API_PREFIX="/api/v1"

# Gemini Configuration
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_HTTP_TIMEOUT_MS="45000"
AI_RATE_LIMIT_MAX_REQUESTS="20"
AI_RATE_LIMIT_WINDOW_MS="60000"

# NASA Earth Observation & Soil Data Endpoints
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api"
NASA_GPM_IMERG_BASE_URL="https://gis.earthdata.nasa.gov/portal/rest/services/GESDISC/GPM_3IMERGHHE/ImageServer"
SOILGRIDS_BASE_URL="https://rest.isric.org/soilgrids/v2.0"
SOILGRIDS_WCS_BASE_URL="https://maps.isric.org/mapserv"
GIBS_WMTS_BASE_URL="https://gibs.earthdata.nasa.gov"

# NASA Earthdata & AppEEARS Authentication (configure via Secrets; never commit credentials)
# - NASA_EARTHDATA_TOKEN: Earthdata Login bearer token for EDL-protected DAAC endpoints
# - AppEEARS (ECOSTRESS ECO_L3T_JET.002 & ECO_L4T_ESI.002) uses either a 48h session Bearer token
#   supplied via NASA_APPEEARS_TOKEN or exchanged via POST /api/login using NASA_EARTHDATA_USERNAME
#   and NASA_EARTHDATA_PASSWORD. NASA_EARTHDATA_TOKEN is also forwarded as fallback if configured alone.
NASA_EARTHDATA_TOKEN=""
NASA_APPEEARS_BASE_URL="https://appeears.earthdatacloud.nasa.gov/api"
NASA_APPEEARS_TOKEN=""
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""

# Weather, Soil & ECOSTRESS Resilience & Caching
WEATHER_CACHE_TTL_MS="900000"
WEATHER_HTTP_TIMEOUT_MS="10000"
SOIL_CACHE_TTL_MS="3600000"
SOIL_HTTP_TIMEOUT_MS="6000"
ECOSTRESS_CACHE_TTL_MS="3600000"
ECOSTRESS_HTTP_TIMEOUT_MS="15000"
ECOSTRESS_JOB_TTL_MS="86400000"

